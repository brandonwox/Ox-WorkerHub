{
  "expo": {
    "name": "Ox WorkerHub",
    "slug": "ox-workerhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oxworkerhub",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1C1C",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1C1C",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ox WorkerHub uses the camera to take photos of your work on jobsites.",
          "microphonePermission": "Ox WorkerHub uses the microphone to record videos of your work on jobsites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ox WorkerHub accesses your photos so you can add existing pictures to a job."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "quickbooksTime": {
        "accessToken": "",
        "baseUrl": "https://rest.tsheets.com/api/v1",
        "autoSync": true,
        "defaultJobcodeId": null,
        "jobcodeMap": {}
      },
      "supabase": {
        "url": "https://ovelhjqoeofjqzvsxoar.supabase.co",
        "anonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im92ZWxoanFvZW9manF6dnN4b2FyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0NDE4MDEsImV4cCI6MjA5NzAxNzgwMX0.j786pKYgvYVjJW-NuevD5VlmjLE7i9TeFXoDu0TwMcc"
      }
    }
  }
}
